{
  "schemaVersion": 1,
  "bundleVariables": {
    "slack_secret_scope": {
      "description": "REQUIRED. Approved Databricks secret scope containing Slack pilot credentials."
    },
    "slack_app_token_secret_key": {
      "description": "REQUIRED. Secret key holding the Socket Mode app token."
    },
    "slack_bot_token_secret_key": {
      "description": "REQUIRED. Secret key holding the Slack bot token."
    },
    "slack_oauth_client_secret_key": {
      "description": "REQUIRED. Implementation-managed secret key holding the Databricks custom OAuth client secret."
    },
    "slack_broker_encryption_key_secret_key": {
      "description": "REQUIRED. Secret key name holding an implementation-generated 32-byte base64 broker encryption key."
    }
  },
  "appResources": [
    {
      "name": "slack-app-token",
      "scopeVariable": "slack_secret_scope",
      "keyVariable": "slack_app_token_secret_key"
    },
    {
      "name": "slack-bot-token",
      "scopeVariable": "slack_secret_scope",
      "keyVariable": "slack_bot_token_secret_key"
    },
    {
      "name": "slack-oauth-client-secret",
      "scopeVariable": "slack_secret_scope",
      "keyVariable": "slack_oauth_client_secret_key"
    },
    {
      "name": "slack-broker-encryption-key",
      "scopeVariable": "slack_secret_scope",
      "keyVariable": "slack_broker_encryption_key_secret_key"
    }
  ],
  "appEnv": [
    {
      "name": "SLACK_ADAPTER_APP_TOKEN",
      "valueFrom": "slack-app-token",
      "referenceName": "SLACK_ADAPTER_APP_TOKEN_SECRET_REF"
    },
    {
      "name": "SLACK_ADAPTER_BOT_TOKEN",
      "valueFrom": "slack-bot-token",
      "referenceName": "SLACK_ADAPTER_BOT_TOKEN_SECRET_REF"
    },
    {
      "name": "SLACK_ADAPTER_OAUTH_CLIENT_SECRET",
      "valueFrom": "slack-oauth-client-secret",
      "referenceName": "SLACK_ADAPTER_OAUTH_CLIENT_SECRET_REF"
    },
    {
      "name": "SLACK_ADAPTER_BROKER_ENCRYPTION_KEY",
      "valueFrom": "slack-broker-encryption-key",
      "referenceName": "SLACK_ADAPTER_BROKER_ENCRYPTION_KEY_REF"
    }
  ]
}
