{
  "schemaVersion": 1,
  "bundleVariables": {
    "slack_secret_scope": {
      "description": "REQUIRED. Approved Databricks secret scope containing Slack pilot credentials."
    },
    "slack_app_token_secret_key": {
      "description": "REQUIRED. Secret key holding the Socket Mode app token."
    },
    "slack_bot_token_secret_key": {
      "description": "REQUIRED. Secret key holding the Slack bot token."
    },
    "slack_client_secret_key": {
      "description": "REQUIRED. Secret key holding the Slack OAuth client secret."
    },
    "slack_signing_secret_key": {
      "description": "REQUIRED. Secret key holding the Slack signing secret."
    }
  },
  "appResources": [
    {
      "name": "slack-app-token",
      "scopeVariable": "slack_secret_scope",
      "keyVariable": "slack_app_token_secret_key"
    },
    {
      "name": "slack-bot-token",
      "scopeVariable": "slack_secret_scope",
      "keyVariable": "slack_bot_token_secret_key"
    },
    {
      "name": "slack-client-secret",
      "scopeVariable": "slack_secret_scope",
      "keyVariable": "slack_client_secret_key"
    },
    {
      "name": "slack-signing-secret",
      "scopeVariable": "slack_secret_scope",
      "keyVariable": "slack_signing_secret_key"
    }
  ],
  "appEnv": [
    {
      "name": "SLACK_ADAPTER_APP_TOKEN",
      "valueFrom": "slack-app-token",
      "referenceName": "SLACK_ADAPTER_APP_TOKEN_SECRET_REF"
    },
    {
      "name": "SLACK_ADAPTER_BOT_TOKEN",
      "valueFrom": "slack-bot-token",
      "referenceName": "SLACK_ADAPTER_BOT_TOKEN_SECRET_REF"
    },
    {
      "name": "SLACK_ADAPTER_CLIENT_SECRET",
      "valueFrom": "slack-client-secret",
      "referenceName": "SLACK_ADAPTER_CLIENT_SECRET_REF"
    },
    {
      "name": "SLACK_ADAPTER_SIGNING_SECRET",
      "valueFrom": "slack-signing-secret",
      "referenceName": "SLACK_ADAPTER_SIGNING_SECRET_REF"
    }
  ]
}
